{
    "compilerOptions": {
        "allowSyntheticDefaultImports": true,
        "forceConsistentCasingInFileNames": true,
        "isolatedModules": true,
        "lib": ["es2021"],
        "module": "es2022",
        "moduleResolution": "bundler",
        "noEmit": true,
        "skipLibCheck": true,
        "strict": true,
        "target": "es2021",
        "types": ["@cloudflare/workers-types"]
    },
    "include": ["src/**/*"]
}
